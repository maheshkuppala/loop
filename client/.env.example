# LOOOP Frontend Environment Variables (Vite)
#
# Production (Vercel):
# Set these in your Vercel Project Settings -> Environment Variables
# Example:
# VITE_API_URL=https://looop-backend.onrender.com/api
# VITE_SOCKET_URL=https://looop-backend.onrender.com
#
# Local Development:
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:5000

VITE_API_URL=
VITE_SOCKET_URL=
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
