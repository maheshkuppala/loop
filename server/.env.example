# LOOOP Backend Environment Variables
#
# Production / Local Database:
# PostgreSQL (Primary database):
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=looop
PGUSER=postgres
PGPASSWORD=your_postgres_password
DATABASE_SSL=false

# Server Settings
NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
CLIENT_URL=http://localhost:3000

# Optional legacy MongoDB connection
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/looop?retryWrites=true&w=majority
