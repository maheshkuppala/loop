# LOOOP Backend Environment Variables
#
# Production / Local Database:
# PostgreSQL (Primary database):
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=looop
PGUSER=postgres
PGPASSWORD=your_postgres_password
DATABASE_SSL=false

# Server Settings
NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
CLIENT_URL=http://localhost:3000
GOOGLE_MAPS_SERVER_API_KEY=YOUR_SERVER_RESTRICTED_KEY

# Email Provider Configuration (Server-Side Only - NEVER expose to client)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=looop.support@gmail.com
BREVO_SENDER_NAME=LOOOP
EMAIL_FROM_ADDRESS=looop.support@gmail.com
EMAIL_FROM_NAME=LOOOP
EMAIL_REPLY_TO=looop.support@gmail.com
EMAIL_DELIVERY_ENABLED=false
BREVO_ACCOUNT_SUSPENDED=true
FRONTEND_URL=http://localhost:3000
WEBHOOK_SECRET=your_webhook_signature_secret_here

# Optional legacy MongoDB connection
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/looop?retryWrites=true&w=majority

